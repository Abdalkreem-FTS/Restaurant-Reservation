<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="Testcontainers.MsSql" Version="4.13.0"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RestaurantReservation.Db\RestaurantReservation.Db.csproj"/>
    </ItemGroup>

    <!-- Global usings so per-file framework using directives are unnecessary. -->
    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="Microsoft.EntityFrameworkCore"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="RestaurantReservation.Db"/>
        <Using Include="RestaurantReservation.Db.Abstractions"/>
        <Using Include="RestaurantReservation.Db.Entities"/>
        <Using Include="RestaurantReservation.Db.Enums"/>
        <Using Include="RestaurantReservation.Db.Pagination"/>
        <Using Include="RestaurantReservation.Db.Repositories"/>
        <Using Include="RestaurantReservation.Db.Results"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
