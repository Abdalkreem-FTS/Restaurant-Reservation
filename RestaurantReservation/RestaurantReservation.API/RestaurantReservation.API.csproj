<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Elastic.Extensions.Logging" Version="9.0.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
        <!-- Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi resolves, which carries GHSA-v5pm-xwqc-g5wc. -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\RestaurantReservation.Db\RestaurantReservation.Db.csproj" />
    </ItemGroup>

    <!-- Global usings so per-file framework using directives are unnecessary. -->
    <ItemGroup>
        <Using Include="RestaurantReservation.API.Authentication" />
        <Using Include="RestaurantReservation.API.Contracts.Common" />
        <Using Include="RestaurantReservation.API.Endpoints" />
        <Using Include="RestaurantReservation.API.Errors" />
        <Using Include="RestaurantReservation.API.Filters" />
        <Using Include="RestaurantReservation.API.OpenApi" />
        <Using Include="RestaurantReservation.API.Services" />
        <Using Include="RestaurantReservation.API.Validators" />
        <Using Include="RestaurantReservation.Db" />
        <Using Include="RestaurantReservation.Db.Abstractions" />
        <Using Include="RestaurantReservation.Db.Entities" />
        <Using Include="RestaurantReservation.Db.Pagination" />
        <Using Include="RestaurantReservation.Db.Results" />
    </ItemGroup>

</Project>
