<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Not RestaurantReservation.Console, so that "Console" still means System.Console. -->
        <RootNamespace>RestaurantReservation</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Elastic.Extensions.Logging" Version="9.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RestaurantReservation.Db\RestaurantReservation.Db.csproj"/>
    </ItemGroup>

    <!-- Global usings so per-file framework using directives are unnecessary. -->
    <ItemGroup>
        <Using Include="Microsoft.EntityFrameworkCore"/>
        <Using Include="Microsoft.Extensions.Configuration"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="RestaurantReservation.Db"/>
        <Using Include="RestaurantReservation.Db.Abstractions"/>
        <Using Include="RestaurantReservation.Db.Entities"/>
        <Using Include="RestaurantReservation.Db.Enums"/>
        <Using Include="RestaurantReservation.Db.Models"/>
        <Using Include="RestaurantReservation.Db.Pagination"/>
        <Using Include="RestaurantReservation.Db.Results"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
